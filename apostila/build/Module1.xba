<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Module1" script:language="StarBasic">
Sub Export(sIn As String, sOut As String)
  On Error Goto Erro
  Dim a(0) As New com.sun.star.beans.PropertyValue
  a(0).Name = &quot;Hidden&quot; : a(0).Value = True
  oDoc = StarDesktop.loadComponentFromURL(ConvertToURL(sIn), &quot;_blank&quot;, 0, a())
  Dim i As Integer
  For i = 0 To oDoc.getDocumentIndexes().getCount() - 1
    oDoc.getDocumentIndexes().getByIndex(i).update()
  Next i
  oDoc.refresh()
  For i = 0 To oDoc.getDocumentIndexes().getCount() - 1
    oDoc.getDocumentIndexes().getByIndex(i).update()
  Next i
  Dim f(0) As New com.sun.star.beans.PropertyValue
  f(0).Name = &quot;FilterName&quot; : f(0).Value = &quot;writer_pdf_Export&quot;
  oDoc.storeToURL(ConvertToURL(sOut), f())
  oDoc.close(True)
  WLog(&quot;ok indexes=&quot; &amp; i)
  Exit Sub
Erro:
  WLog(&quot;erro &quot; &amp; Err &amp; &quot; &quot; &amp; Error$ &amp; &quot; linha &quot; &amp; Erl)
End Sub
Sub WLog(s As String)
  n = FreeFile
  Open &quot;/home/guilherme-carneiro/lo_build_tmp_apostila/log.txt&quot; For Append As #n
  Print #n, s
  Close #n
End Sub
</script:module>
